# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# test artefacts
/.next-test/
/test-results/
/playwright-report/
/backups/
/.next-load/
/.next-check/
/test-results/

# deployment details and secrets (local only)
/.deploy/

/.next-deploy/
/.next-test/

# Only the Windows deployment guide is versioned documentation.
*.[mM][dD]
*.[pP][dD][fF]
*.[dD][oO][cC]
*.[dD][oO][cC][xX]
*.[oO][dD][tT]
*.[pP][pP][tT]
*.[pP][pP][tT][xX]
!/WINDOWS_DEPLOYMENT_GUIDE.md
/docs/
/assets/
/scripts/report/
/scripts/guide/

# Local AWS/container deployment tooling and credentials.
/scripts/deploy/
/scripts/compose.sh
/Dockerfile
/docker-compose.yml
/.dockerignore
/.aws/
*.sql.gz
*.tar.gz

# Explicitly requested: version the original application environment.
!/.env
