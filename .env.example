# MySQL connection (root is used so Prisma can create its shadow database for migrations)
DATABASE_URL="mysql://root:edupilot_root@localhost:3307/edupilot"
# Secret used to sign session JWTs — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Address people use to reach the app. Used in links inside emails (password reset, alerts).
APP_URL="http://localhost:3000"

# Email alerts. Any SMTP server works; a free Gmail account with an "App password" is enough to start.
# Leave SMTP_HOST empty to keep emails in the outbox (Administration → Email outbox) without sending.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
# Set 0 to pause academic/account notifications; OTP, recovery and security mail stay enabled.
ACADEMIC_EMAILS_ENABLED="1"

# Backups. In production (npm run prod:up) a backup service writes ./backups every night by itself.
# Set BACKUP_MIRROR_DIR to a folder on another disk, a NAS or a cloud-synced folder for a second copy.
BACKUP_MIRROR_DIR=""
# When running without Docker, set AUTO_BACKUP=1 to have the app run the backup once a day (needs mysqldump installed).
AUTO_BACKUP=""
